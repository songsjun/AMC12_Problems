{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/approved-archive-question-context-set-v2.schema.json",
  "title": "Private selected-form AMC archive context approved through operator-delegated AI-assisted review",
  "$comment": "Runtime validation enforces cross-record reviewer/operator/authority separation and supplement-author/reviewer separation in every child.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "approvalPolicyVersion", "reviewGovernance", "candidateSetBinding", "reviewDecisionBinding", "approvalAuthorityBinding", "summary", "forms", "disclaimer", "setHash"],
  "properties": {
    "schemaVersion": {"const": "amc-approved-question-context-archive-set-v2"},
    "audience": {"const": "private-ai-context-only"},
    "approvalPolicyVersion": {"const": "amc-operator-delegated-ai-assisted-solution-approval-v1"},
    "reviewGovernance": {"$ref": "approved-question-context-set-v2.schema.json#/$defs/reviewGovernance"},
    "candidateSetBinding": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "setHash", "archiveRelease"],
      "properties": {
        "schemaVersion": {"enum": ["amc-question-context-archive-candidate-set-v1", "amc-question-context-supplemented-archive-candidate-set-v1"]},
        "setHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "archiveRelease": {
          "type": "object", "additionalProperties": false,
          "required": ["batchSchemaVersion", "releaseVersion", "sourcePath", "sourceSha256"],
          "properties": {
            "batchSchemaVersion": {"const": "amc-practice-archive-release-batch-v1"},
            "releaseVersion": {"type": "string", "minLength": 1},
            "sourcePath": {"type": "string", "minLength": 1},
            "sourceSha256": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"}
          }
        }
      }
    },
    "reviewDecisionBinding": {"$ref": "approved-question-context-set-v2.schema.json#/$defs/reviewBinding"},
    "approvalAuthorityBinding": {"$ref": "approved-question-context-set.schema.json#/$defs/authorityBinding"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["formCount", "questionCount", "approvedSolutionCount", "contextReadyQuestionCount", "unavailableQuestionCount"],
      "properties": {
        "formCount": {"type": "integer", "minimum": 1, "maximum": 48},
        "questionCount": {"type": "integer", "minimum": 25, "maximum": 1200},
        "approvedSolutionCount": {"type": "integer", "minimum": 0},
        "contextReadyQuestionCount": {"type": "integer", "minimum": 0},
        "unavailableQuestionCount": {"type": "integer", "minimum": 0}
      }
    },
    "forms": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "approved-question-context-set-v2.schema.json"}},
    "disclaimer": {"type": "string", "minLength": 1},
    "setHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"}
  }
}

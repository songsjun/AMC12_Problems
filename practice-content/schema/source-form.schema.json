{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.example/schema/amc-practice-source-form-v1.json",
  "title": "AMC Practice Source Form v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "publicationStatus",
    "isSynthetic",
    "durationSeconds",
    "scoringPolicyVersion",
    "scoringPolicy",
    "contentRights",
    "sourceFiles"
  ],
  "properties": {
    "schemaVersion": {"const": "amc-practice-source-form-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publicationStatus": {"enum": ["review-required", "approved", "test-only"]},
    "isSynthetic": {"type": "boolean"},
    "durationSeconds": {"const": 4500},
    "scoringPolicyVersion": {"type": "string", "minLength": 1},
    "scoringPolicy": {
      "type": "object",
      "required": ["version", "correct", "blank", "incorrect", "questionCount", "maxScore"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "correct": {"type": "number", "minimum": 0},
        "blank": {"type": "number", "minimum": 0},
        "incorrect": {"type": "number", "minimum": 0},
        "questionCount": {"const": 25},
        "maxScore": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "contentRights": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["review-required", "approved", "synthetic", "not-cleared"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["number", "path"],
        "properties": {
          "number": {"type": "integer", "minimum": 1, "maximum": 25},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

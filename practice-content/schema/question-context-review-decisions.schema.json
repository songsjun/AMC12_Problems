{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/question-context-review-decisions.schema.json",
  "title": "Explicit human approvals for AMC question-context candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "approvalPolicyVersion", "candidateSetBinding", "decisions", "decisionSetHash"],
  "properties": {
    "schemaVersion": {"const": "amc-question-context-review-decisions-v1"},
    "audience": {"const": "private-human-review-input"},
    "approvalPolicyVersion": {"const": "amc-explicit-human-solution-approval-v1"},
    "candidateSetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "setHash", "forms"],
      "properties": {
        "schemaVersion": {"enum": ["amc-question-context-candidate-set-v1", "amc-question-context-archive-candidate-set-v1"]},
        "setHash": {"$ref": "#/$defs/sha256"},
        "forms": {
          "type": "array", "minItems": 1, "maxItems": 48,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "version"],
            "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "decisions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/decision"}},
    "decisionSetHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formId", "formVersion", "questionNumber", "solutionId", "decision", "bodySha256", "sourceRef", "reviewerId", "reviewedAt", "rightsStatus", "qualityFlags", "methodTags", "decisionRecordHash"],
      "properties": {
        "formId": {"type": "string", "minLength": 1},
        "formVersion": {"type": "string", "minLength": 1},
        "questionNumber": {"type": "integer", "minimum": 1, "maximum": 25},
        "solutionId": {"type": "string", "pattern": "^solution-[0-9]{3}$"},
        "decision": {"const": "approved"},
        "bodySha256": {"$ref": "#/$defs/sha256"},
        "sourceRef": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "reviewerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"},
        "reviewedAt": {"$ref": "#/$defs/utcTimestamp"},
        "rightsStatus": {"const": "approved-for-ai-use"},
        "qualityFlags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
        "methodTags": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
        "decisionRecordHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}

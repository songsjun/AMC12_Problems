# Server network. The defaults intentionally bind only to localhost.
AMC12_HOST=127.0.0.1
AMC12_PORT=8090
NODE_ENV=development

# Required outside local development; use >= 32 random bytes.
AMC12_SESSION_SECRET=replace-with-a-long-random-secret
# Optional separate HMAC pepper for access-code and CSRF token hashes.
AMC12_AUTH_PEPPER=replace-with-a-different-long-random-secret

# PostgreSQL is required in normal operation.
AMC12_DATABASE_URL=postgres://amc_practice:change-me@127.0.0.1:5432/amc_practice

# API is normally reverse-proxied on the same origin. Set one exact frontend
# origin only when it is intentionally served cross-origin.
# AMC12_CORS_ORIGIN=http://127.0.0.1:4173
# AMC12_SECURE_COOKIES=false

# The API defaults to `loopback`, appropriate only behind nginx that overwrites
# X-Forwarded-For. For a directly public listener, set this to false.
# AMC12_TRUST_PROXY=loopback

# Optional development-only bootstrap. Never set these in production.
# AMC12_DEV_ACCESS_CODE=local-practice-code
# AMC12_DEV_STUDENT_NAME=Local student

# Development-only synthetic fixture gates. Import and publication are separate:
# importing does not make a form student-visible; publishing also needs
# `npm run import-form -- file.json --publish`. Both are ignored in production.
# AMC12_ALLOW_TEST_ONLY_IMPORT=true
# AMC12_ALLOW_TEST_ONLY_PUBLISH=true

# The generic manifest adapter is for explicit local experiments only. A
# production import accepts only reviewed amc-practice-private-form-v1 files.
# AMC12_ALLOW_GENERIC_MANIFEST_IMPORT=true

# Sessions expire after this many hours (default: 12).
AMC12_SESSION_HOURS=12
# Worker poll cadence (default: 5000).
AMC12_DEADLINE_POLL_MS=5000

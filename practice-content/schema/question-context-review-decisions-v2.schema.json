{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/question-context-review-decisions-v2.schema.json",
  "title": "Operator-delegated AI-assisted AMC solution review decisions",
  "$comment": "Runtime validation requires reviewerId, operatorAuthorization.authorizedBy, and receipt authority to be pairwise distinct; a supplemental candidate author must also differ from reviewerId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "approvalPolicyVersion", "candidateSetBinding", "operatorAuthorization", "decisions", "decisionSetHash"],
  "properties": {
    "schemaVersion": {"const": "amc-question-context-review-decisions-v2"},
    "audience": {"const": "private-operator-delegated-ai-assisted-review-input"},
    "approvalPolicyVersion": {"const": "amc-operator-delegated-ai-assisted-solution-approval-v1"},
    "candidateSetBinding": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "setHash", "forms"],
      "properties": {
        "schemaVersion": {"enum": ["amc-question-context-candidate-set-v1", "amc-question-context-archive-candidate-set-v1", "amc-question-context-supplemented-archive-candidate-set-v1"]},
        "setHash": {"$ref": "#/$defs/sha256"},
        "forms": {"type": "array", "minItems": 1, "maxItems": 48, "items": {"$ref": "#/$defs/form"}}
      }
    },
    "operatorAuthorization": {"$ref": "#/$defs/operatorAuthorization"},
    "decisions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/decision"}},
    "decisionSetHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opaqueId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "form": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "operatorAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorizationId", "authorizedBy", "authorizedAt", "scope", "statement", "rightsAttestation"],
      "properties": {
        "authorizationId": {"$ref": "#/$defs/opaqueId"},
        "authorizedBy": {"$ref": "#/$defs/opaqueId"},
        "authorizedAt": {"$ref": "#/$defs/utcTimestamp"},
        "scope": {"const": "solution-correctness-pedagogy-and-rights-review"},
        "statement": {"const": "operator-delegates-ai-assisted-solution-review"},
        "rightsAttestation": {"const": "operator-attests-rights-for-reviewed-source-ai-use"}
      }
    },
    "reviewModel": {
      "type": "object", "additionalProperties": false, "required": ["provider", "model", "runId"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "runId": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256}
      }
    },
    "candidateProvenance": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "sourcePath", "sourceSha256"],
          "properties": {
            "origin": {"const": "source-markdown"}, "sourcePath": {"$ref": "#/$defs/relativePath"},
            "sourceSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["origin", "supplementId", "supplementSetHash", "supplementRecordHash", "authorId", "createdAt", "rightsStatus", "rightsAuthorizationId"],
          "properties": {
            "origin": {"const": "operator-original-supplement"},
            "supplementId": {"type": "string", "pattern": "^supplement-[a-z0-9][a-z0-9-]{2,63}$"},
            "supplementSetHash": {"$ref": "#/$defs/sha256"},
            "supplementRecordHash": {"$ref": "#/$defs/sha256"},
            "authorId": {"$ref": "#/$defs/opaqueId"},
            "createdAt": {"$ref": "#/$defs/utcTimestamp"},
            "rightsStatus": {"const": "operator-attested-original-and-authorized-for-ai-use"},
            "rightsAuthorizationId": {"$ref": "#/$defs/opaqueId"}
          }
        }
      ]
    },
    "sourceRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["formId", "formVersion", "questionNumber", "questionContentHash", "solutionId", "decision", "bodySha256", "sourceRef", "reviewerId", "reviewedAt", "rightsStatus", "qualityFlags", "methodTags", "reviewMethod", "reviewModel", "operatorAuthorizationId", "candidateProvenance", "decisionRecordHash"],
      "properties": {
        "formId": {"type": "string", "minLength": 1},
        "formVersion": {"type": "string", "minLength": 1},
        "questionNumber": {"type": "integer", "minimum": 1, "maximum": 25},
        "questionContentHash": {"$ref": "#/$defs/sha256"},
        "solutionId": {"type": "string", "pattern": "^solution-[0-9]{3}$"},
        "decision": {"const": "approved"},
        "bodySha256": {"$ref": "#/$defs/sha256"},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "reviewerId": {"$ref": "#/$defs/opaqueId"},
        "reviewedAt": {"$ref": "#/$defs/utcTimestamp"},
        "rightsStatus": {"const": "approved-for-ai-use"},
        "qualityFlags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
        "methodTags": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
        "reviewMethod": {"const": "operator-delegated-ai-assisted"},
        "reviewModel": {"$ref": "#/$defs/reviewModel"},
        "operatorAuthorizationId": {"$ref": "#/$defs/opaqueId"},
        "candidateProvenance": {"$ref": "#/$defs/candidateProvenance"},
        "decisionRecordHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

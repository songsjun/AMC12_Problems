{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.example/schema/amc-practice-archive-public-form-v1.json",
  "title": "AMC Historical Archive Practice Public Form v1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "publicationStatus", "isSynthetic", "durationSeconds", "scoringPolicyVersion", "scoringPolicy", "questionBundleHash", "archiveNotice", "questions", "contentHash"],
  "properties": {
    "schemaVersion": {"const": "amc-practice-public-form-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publicationStatus": {"const": "archive-practice"},
    "isSynthetic": {"const": false},
    "durationSeconds": {"const": 4500},
    "scoringPolicyVersion": {"type": "string", "minLength": 1},
    "scoringPolicy": {"$ref": "#/$defs/scoringPolicy"},
    "questionBundleHash": {"$ref": "#/$defs/hash"},
    "archiveNotice": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"$ref": "#/$defs/question"}},
    "contentHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scoringPolicy": {
      "type": "object",
      "required": ["version", "correct", "blank", "incorrect", "questionCount", "scoredQuestionCount", "maxScore"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "correct": {"type": "number", "minimum": 0},
        "blank": {"type": "number", "minimum": 0},
        "incorrect": {"type": "number", "minimum": 0},
        "questionCount": {"const": 25},
        "scoredQuestionCount": {"type": "integer", "minimum": 0, "maximum": 25},
        "maxScore": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "choices": {
      "type": "object",
      "required": ["A", "B", "C", "D", "E"],
      "properties": {"A": {"type": "string", "minLength": 1}, "B": {"type": "string", "minLength": 1}, "C": {"type": "string", "minLength": 1}, "D": {"type": "string", "minLength": 1}, "E": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["number", "promptMarkdown", "choices", "isScored"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 25},
        "promptMarkdown": {"type": "string", "minLength": 1},
        "choices": {"$ref": "#/$defs/choices"},
        "isScored": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

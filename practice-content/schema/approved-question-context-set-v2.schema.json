{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/approved-question-context-set-v2.schema.json",
  "title": "Private AMC context approved through operator-delegated AI-assisted review",
  "$comment": "Runtime validation enforces cross-record reviewer/operator/authority separation and supplement-author/reviewer separation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "approvalPolicyVersion", "reviewGovernance", "formBinding", "reviewDecisionBinding", "approvalAuthorityBinding", "summary", "questions", "disclaimer", "setHash"],
  "properties": {
    "schemaVersion": {"const": "amc-approved-question-context-set-v2"},
    "audience": {"const": "private-ai-context-only"},
    "approvalPolicyVersion": {"const": "amc-operator-delegated-ai-assisted-solution-approval-v1"},
    "reviewGovernance": {"$ref": "#/$defs/reviewGovernance"},
    "formBinding": {"$ref": "#/$defs/formBinding"},
    "reviewDecisionBinding": {"$ref": "#/$defs/reviewBinding"},
    "approvalAuthorityBinding": {"$ref": "approved-question-context-set.schema.json#/$defs/authorityBinding"},
    "summary": {"$ref": "approved-question-context-set.schema.json#/$defs/summary"},
    "questions": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"$ref": "#/$defs/question"}},
    "disclaimer": {"type": "string", "minLength": 1},
    "setHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "formBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "candidateSchemaVersion", "candidateSetHash", "contextContentHash", "releaseBinding"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "candidateSchemaVersion": {"enum": ["amc-question-context-candidate-set-v1", "amc-question-context-archive-candidate-set-v1", "amc-question-context-supplemented-archive-candidate-set-v1"]},
        "candidateSetHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "contextContentHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "releaseBinding": {"$ref": "approved-question-context-set.schema.json#/$defs/releaseBinding"}
      }
    },
    "reviewBinding": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "decisionSetHash"],
      "properties": {
        "schemaVersion": {"const": "amc-question-context-review-decisions-v2"},
        "decisionSetHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"}
      }
    },
    "reviewGovernance": {
      "type": "object", "additionalProperties": false, "required": ["reviewMethod", "operatorAuthorization"],
      "properties": {
        "reviewMethod": {"const": "operator-delegated-ai-assisted"},
        "operatorAuthorization": {"$ref": "question-context-review-decisions-v2.schema.json#/$defs/operatorAuthorization"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "sourceRef", "promptMarkdown", "choices", "questionContentHash", "visualContext", "contextReady", "availability", "approvedSolutions"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 25},
        "sourceRef": {"$ref": "approved-question-context-set.schema.json#/$defs/sourceRef"},
        "promptMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384, "x-maxUtf8Bytes": 16384},
        "choices": {
          "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E"],
          "properties": {
            "A": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048},
            "B": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048},
            "C": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048},
            "D": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048},
            "E": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}
          }
        },
        "questionContentHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "visualContext": {
          "type": "object", "additionalProperties": false, "required": ["required", "modelAvailable", "reason"],
          "properties": {"required": {"type": "boolean"}, "modelAvailable": {"type": "boolean"}, "reason": {"enum": [null, "question-visual-context-unavailable"]}}
        },
        "contextReady": {"type": "boolean"},
        "availability": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "approvedSolutionCount", "modelEligibleSolutionCount", "requiredSolutionCount", "reason"],
          "properties": {
            "status": {"enum": ["ready", "unavailable"]},
            "approvedSolutionCount": {"type": "integer", "minimum": 0},
            "modelEligibleSolutionCount": {"type": "integer", "minimum": 0},
            "requiredSolutionCount": {"const": 2},
            "reason": {"enum": [null, "question-visual-context-unavailable", "fewer-than-two-model-eligible-approved-solutions"]}
          }
        },
        "approvedSolutions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/solution"}}
      }
    },
    "solution": {
      "type": "object", "additionalProperties": false,
      "required": ["solutionId", "title", "bodyMarkdown", "bodySha256", "sourceRef", "candidateProvenance", "modelEligibility", "approval"],
      "properties": {
        "solutionId": {"type": "string", "pattern": "^solution-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "bodyMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384, "x-maxUtf8Bytes": 16384},
        "bodySha256": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "sourceRef": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256", "headingLine", "endLine"],
          "properties": {
            "path": {"$ref": "approved-question-context-set.schema.json#/$defs/relativePath"},
            "sha256": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
            "headingLine": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}
          }
        },
        "candidateProvenance": {"$ref": "question-context-review-decisions-v2.schema.json#/$defs/candidateProvenance"},
        "modelEligibility": {
          "type": "object", "additionalProperties": false, "required": ["eligible", "reason"],
          "properties": {"eligible": {"type": "boolean"}, "reason": {"enum": [null, "solution-visual-context-unavailable"]}}
        },
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewerId", "reviewedAt", "rightsStatus", "qualityFlags", "methodTags", "reviewMethod", "reviewModel", "operatorAuthorizationId", "decisionRecordHash", "authorityReceipt"],
      "properties": {
        "reviewerId": {"$ref": "approved-question-context-set.schema.json#/$defs/opaqueId"},
        "reviewedAt": {"$ref": "approved-question-context-set.schema.json#/$defs/utcTimestamp"},
        "rightsStatus": {"const": "approved-for-ai-use"},
        "qualityFlags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "approved-question-context-set.schema.json#/$defs/tag"}},
        "methodTags": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "approved-question-context-set.schema.json#/$defs/tag"}},
        "reviewMethod": {"const": "operator-delegated-ai-assisted"},
        "reviewModel": {"$ref": "question-context-review-decisions-v2.schema.json#/$defs/reviewModel"},
        "operatorAuthorizationId": {"$ref": "approved-question-context-set.schema.json#/$defs/opaqueId"},
        "decisionRecordHash": {"$ref": "approved-question-context-set.schema.json#/$defs/sha256"},
        "authorityReceipt": {"$ref": "approved-question-context-set.schema.json#/$defs/authorityReceipt"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/approved-question-context-set.schema.json",
  "title": "Private AMC approved AI question context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "approvalPolicyVersion", "formBinding", "reviewDecisionBinding", "approvalAuthorityBinding", "summary", "questions", "disclaimer", "setHash"],
  "properties": {
    "schemaVersion": {"const": "amc-approved-question-context-set-v1"},
    "audience": {"const": "private-ai-context-only"},
    "approvalPolicyVersion": {"const": "amc-explicit-human-solution-approval-v1"},
    "formBinding": {"$ref": "#/$defs/formBinding"},
    "reviewDecisionBinding": {"$ref": "#/$defs/reviewBinding"},
    "approvalAuthorityBinding": {"$ref": "#/$defs/authorityBinding"},
    "summary": {"$ref": "#/$defs/summary"},
    "questions": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"$ref": "#/$defs/question"}},
    "disclaimer": {"type": "string", "minLength": 1},
    "setHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sourceRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionBundleHash", "contentHash", "manifestHash"],
      "properties": {
        "questionBundleHash": {"$ref": "#/$defs/sha256"},
        "contentHash": {"$ref": "#/$defs/sha256"},
        "manifestHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "formBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "candidateSchemaVersion", "candidateSetHash", "contextContentHash", "releaseBinding"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "candidateSchemaVersion": {"enum": ["amc-question-context-candidate-set-v1", "amc-question-context-archive-candidate-set-v1"]},
        "candidateSetHash": {"$ref": "#/$defs/sha256"}, "contextContentHash": {"$ref": "#/$defs/sha256"},
        "releaseBinding": {"$ref": "#/$defs/releaseBinding"}
      }
    },
    "reviewBinding": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "decisionSetHash"],
      "properties": {"schemaVersion": {"const": "amc-question-context-review-decisions-v1"}, "decisionSetHash": {"$ref": "#/$defs/sha256"}}
    },
    "authorityBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "authorityId", "receiptSetHash"],
      "properties": {
        "schemaVersion": {"const": "amc-solution-approval-receipt-set-v1"},
        "authorityId": {"$ref": "#/$defs/opaqueId"},
        "receiptSetHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["questionCount", "approvedSolutionCount", "contextReadyQuestionCount", "unavailableQuestionCount", "minimumApprovedSolutionsPerQuestion"],
      "properties": {
        "questionCount": {"const": 25}, "approvedSolutionCount": {"type": "integer", "minimum": 0},
        "contextReadyQuestionCount": {"type": "integer", "minimum": 0, "maximum": 25},
        "unavailableQuestionCount": {"type": "integer", "minimum": 0, "maximum": 25},
        "minimumApprovedSolutionsPerQuestion": {"const": 2}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "sourceRef", "promptMarkdown", "choices", "questionContentHash", "visualContext", "contextReady", "availability", "approvedSolutions"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 25}, "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "promptMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384, "x-maxUtf8Bytes": 16384},
        "choices": {
          "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E"],
          "properties": {"A": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}, "B": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}, "C": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}, "D": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}, "E": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}}
        },
        "questionContentHash": {"$ref": "#/$defs/sha256"},
        "visualContext": {
          "type": "object", "additionalProperties": false, "required": ["required", "modelAvailable", "reason"],
          "properties": {"required": {"type": "boolean"}, "modelAvailable": {"type": "boolean"}, "reason": {"enum": [null, "question-visual-context-unavailable"]}}
        },
        "contextReady": {"type": "boolean"},
        "availability": {
          "type": "object", "additionalProperties": false, "required": ["status", "approvedSolutionCount", "modelEligibleSolutionCount", "requiredSolutionCount", "reason"],
          "properties": {
            "status": {"enum": ["ready", "unavailable"]}, "approvedSolutionCount": {"type": "integer", "minimum": 0},
            "modelEligibleSolutionCount": {"type": "integer", "minimum": 0},
            "requiredSolutionCount": {"const": 2}, "reason": {"enum": [null, "question-visual-context-unavailable", "fewer-than-two-model-eligible-approved-solutions"]}
          }
        },
        "approvedSolutions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/solution"}}
      }
    },
    "solution": {
      "type": "object", "additionalProperties": false,
      "required": ["solutionId", "title", "bodyMarkdown", "bodySha256", "sourceRef", "modelEligibility", "approval"],
      "properties": {
        "solutionId": {"type": "string", "pattern": "^solution-[0-9]{3}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "bodyMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384, "x-maxUtf8Bytes": 16384}, "bodySha256": {"$ref": "#/$defs/sha256"},
        "sourceRef": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256", "headingLine", "endLine"],
          "properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "headingLine": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}}
        },
        "modelEligibility": {
          "type": "object", "additionalProperties": false, "required": ["eligible", "reason"],
          "properties": {"eligible": {"type": "boolean"}, "reason": {"enum": [null, "solution-visual-context-unavailable"]}}
        },
        "approval": {
          "type": "object", "additionalProperties": false, "required": ["reviewerId", "reviewedAt", "rightsStatus", "qualityFlags", "methodTags", "decisionRecordHash", "authorityReceipt"],
          "properties": {
            "reviewerId": {"$ref": "#/$defs/opaqueId"}, "reviewedAt": {"$ref": "#/$defs/utcTimestamp"},
            "rightsStatus": {"const": "approved-for-ai-use"},
            "qualityFlags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
            "methodTags": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
            "decisionRecordHash": {"$ref": "#/$defs/sha256"},
            "authorityReceipt": {"$ref": "#/$defs/authorityReceipt"}
          }
        }
      }
    },
    "authorityReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptId", "authorityId", "issuedAt", "status"],
      "properties": {
        "receiptId": {"$ref": "#/$defs/opaqueId"}, "authorityId": {"$ref": "#/$defs/opaqueId"},
        "issuedAt": {"$ref": "#/$defs/utcTimestamp"},
        "status": {"const": "active"}
      }
    },
    "opaqueId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapy.local/schema/original-solution-supplement-set.schema.json",
  "title": "Protected operator-original AMC solution supplement candidates",
  "$comment": "A later v2 review must use a reviewerId distinct from this supplement's provenance.authorId; that cross-document comparison is enforced by runtime validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "audience", "provenancePolicyVersion", "operatorAuthorization", "archiveCandidateBinding", "supplements", "supplementSetHash"],
  "properties": {
    "schemaVersion": {"const": "amc-original-solution-supplement-set-v1"},
    "audience": {"const": "private-candidate-supplement-input"},
    "provenancePolicyVersion": {"const": "amc-operator-original-solution-provenance-v1"},
    "operatorAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorizationId", "authorizedBy", "authorizedAt", "statement"],
      "properties": {
        "authorizationId": {"$ref": "#/$defs/opaqueId"}, "authorizedBy": {"$ref": "#/$defs/opaqueId"},
        "authorizedAt": {"$ref": "#/$defs/utcTimestamp"},
        "statement": {"const": "operator-attests-original-supplement-and-authorizes-ai-use"}
      }
    },
    "archiveCandidateBinding": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "setHash", "archiveRelease"],
      "properties": {
        "schemaVersion": {"const": "amc-question-context-archive-candidate-set-v1"},
        "setHash": {"$ref": "#/$defs/sha256"},
        "archiveRelease": {"$ref": "#/$defs/archiveRelease"}
      }
    },
    "supplements": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/supplement"}},
    "supplementSetHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opaqueId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "archiveRelease": {
      "type": "object", "additionalProperties": false,
      "required": ["batchSchemaVersion", "releaseVersion", "sourcePath", "sourceSha256"],
      "properties": {
        "batchSchemaVersion": {"const": "amc-practice-archive-release-batch-v1"},
        "releaseVersion": {"type": "string", "minLength": 1}, "sourcePath": {"type": "string", "minLength": 1},
        "sourceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "releaseBinding": {
      "type": "object", "additionalProperties": false, "required": ["questionBundleHash", "contentHash", "manifestHash"],
      "properties": {"questionBundleHash": {"$ref": "#/$defs/sha256"}, "contentHash": {"$ref": "#/$defs/sha256"}, "manifestHash": {"$ref": "#/$defs/sha256"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "authorId", "createdAt", "rightsStatus", "rightsAuthorizationId"],
      "properties": {
        "origin": {"const": "operator-commissioned-original"}, "authorId": {"$ref": "#/$defs/opaqueId"},
        "createdAt": {"$ref": "#/$defs/utcTimestamp"},
        "rightsStatus": {"const": "operator-attested-original-and-authorized-for-ai-use"},
        "rightsAuthorizationId": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "supplement": {
      "type": "object", "additionalProperties": false,
      "required": ["supplementId", "solutionId", "formId", "formVersion", "questionNumber", "questionContentHash", "releaseBinding", "title", "bodyMarkdown", "bodySha256", "provenance", "supplementRecordHash"],
      "properties": {
        "supplementId": {"type": "string", "pattern": "^supplement-[a-z0-9][a-z0-9-]{2,63}$"},
        "solutionId": {"type": "string", "pattern": "^solution-9[0-9]{2}$"},
        "formId": {"type": "string", "minLength": 1}, "formVersion": {"type": "string", "minLength": 1},
        "questionNumber": {"type": "integer", "minimum": 1, "maximum": 25},
        "questionContentHash": {"$ref": "#/$defs/sha256"}, "releaseBinding": {"$ref": "#/$defs/releaseBinding"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
        "bodyMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384, "x-maxUtf8Bytes": 16384},
        "bodySha256": {"$ref": "#/$defs/sha256"}, "provenance": {"$ref": "#/$defs/provenance"},
        "supplementRecordHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
